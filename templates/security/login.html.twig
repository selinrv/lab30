{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}
<form method="post" style="max-width: 360px; margin: 4rem auto; font-family: system-ui, sans-serif;">
    {% if error %}
        <div style="background:#fee; color:#900; padding:.75rem; margin-bottom:1rem; border-radius:4px;">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    {% if app.user %}
        <p>You are logged in as {{ app.user.userIdentifier }}. <a href="{{ path('app_logout') }}">Log out</a></p>
    {% endif %}

    <h1>Sign in</h1>

    <label for="username">Email</label><br>
    <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus style="width:100%; padding:.5rem; margin-bottom:1rem;">

    <label for="password">Password</label><br>
    <input type="password" name="_password" id="password" autocomplete="current-password" required style="width:100%; padding:.5rem; margin-bottom:1rem;">

    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

    <button type="submit" style="padding:.6rem 1.2rem;">Sign in</button>
</form>
{% endblock %}