{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Admin Dashboard{% endblock %}

{% block main %}
    <div class="container mt-4">
        <h2>Microstructure monitor</h2>

        <div class="card">
            <div class="card-body text-center">
                <div class="position-relative d-inline-block">
                    <video id="webcam" autoplay playsinline width="800" height="450"
                           class="border rounded"></video>
                    <img id="overlay" alt=""
                         class="position-absolute"
                         style="top: 10px; right: 10px; width: 100px; pointer-events: none; display: none;" />
                </div>
                <canvas id="snapshot" width="2720" height="2048" class="d-none"></canvas>

                <div class="mt-3 d-flex justify-content-center align-items-center gap-2 flex-wrap">
                    <button class="btn btn-primary" onclick="startCamera()">Start Camera</button>
                    <button class="btn btn-secondary" onclick="takeSnapshot()">Take Snapshot</button>
                    <button class="btn btn-danger" onclick="clearSession()">Clear session</button>


                </div>
                <div class="mt-3 d-flex justify-content-center align-items-center gap-2 flex-wrap">

                    <label for="alloy" class="ms-3 mb-0">Alloy</label>
                    <input type="text" id="alloy" class="form-control" style="width:auto;" />

                    <label for="position" class="ms-3 mb-0">Position</label>
                    <select id="position" class="form-select" style="width:auto;">
                        <option value="--">--</option>
                        <option value="om">Base Metal</option>
                        <option value="weld">Weld</option>
                        <option value="haz">HAZ</option>
                        <option value="fusion_zone">Fusion Zone</option>
                    </select>

                    <label for="magnification" class="ms-3 mb-0">Scale</label>
                    <select id="magnification" class="form-select" style="width:auto;">
                        <option value="--">--</option>
                        <option value="5">x5</option>
                        <option value="20">x20</option>
                        <option value="50">x50</option>
                        <option value="100">x100</option>
                    </select>
                </div>

                <div id="gallery" class="mt-4 d-flex flex-wrap gap-3 justify-content-center"></div>
            </div>
        </div>
    </div>

    <div id="lightbox" class="position-fixed top-0 start-0 w-100 h-100 d-none"
         style="background: rgba(0,0,0,0.85); z-index: 2000; cursor: zoom-out;">
        <button type="button" id="lightbox-close"
                class="btn-close btn-close-white position-absolute"
                style="top: 1rem; right: 1rem; z-index: 2001;" aria-label="Close"></button>
        <img id="lightbox-img" alt=""
             class="position-absolute top-50 start-50 translate-middle"
             style="max-width: 95vw; max-height: 95vh;" />
    </div>

    {% block javascripts %}
        <script>
            let stream = null;
            const SESSION_KEY = 'microstructureSession';

            function loadSession() {
                try {
                    return JSON.parse(localStorage.getItem(SESSION_KEY)) || [];
                } catch (e) {
                    return [];
                }
            }

            function saveSession(filenames) {
                localStorage.setItem(SESSION_KEY, JSON.stringify(filenames));
            }

            function addToSession(filename) {
                const list = loadSession();
                if (!list.includes(filename)) {
                    list.push(filename);
                    saveSession(list);
                }
            }

            function removeFromSession(filename) {
                saveSession(loadSession().filter(f => f !== filename));
            }

            async function startCamera() {
                try {
                    stream = await navigator.mediaDevices.getUserMedia({
                        video: {
                            width:  { ideal: 2720 },
                            height: { ideal: 2048 },
                        },
                        audio: false,
                    });
                    document.getElementById('webcam').srcObject = stream;
                } catch (err) {
                    alert('Camera access denied: ' + err.message);
                }
            }

            function takeSnapshot() {
                const video = document.getElementById('webcam');
                const canvas = document.getElementById('snapshot');
                const ctx = canvas.getContext('2d');
                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

                const overlay = document.getElementById('overlay');
                if (overlay.complete && overlay.naturalWidth > 0 && overlay.style.display !== 'none') {
                    const w = canvas.width * 0.125;
                    const h = w * overlay.naturalHeight / overlay.naturalWidth;
                    const margin = canvas.width * 0.0125;
                    const x = canvas.width - margin - w;
                    const y = margin;
                    ctx.drawImage(overlay, x, y, w, h);
                }

                const dataUrl = canvas.toDataURL('image/png');
                const magnification = document.getElementById('magnification').value;
                const alloy = document.getElementById('alloy').value;
                const position = document.getElementById('position').value;

                fetch('/admin/snapshot', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ image: dataUrl, magnification, alloy, position }),
                })
                .then(r => r.json())
                .then(data => {
                    if (data.ok) {
                        appendToGallery(data.filename, dataUrl);
                        addToSession(data.filename);
                        flasher.use('theme.ios').success(data.message);

                    } else {
                        console.error('Save failed:', data.error);
                        alert('Save failed: ' + data.error);
                    }
                })
                .catch(err => {
                    console.error('Save error:', err);
                    alert('Save error: ' + err.message);
                });
            }

            function appendToGallery(filename, src) {
                const imgSrc = src || ('/uploads/snapshots/' + filename);
                const card = document.createElement('div');
                card.className = 'card';
                card.style.width = '200px';
                card.innerHTML = `
                    <img class="card-img-top" alt="" style="cursor: zoom-in;">
                    <div class="card-body p-2 text-center">
                        <small class="d-block text-truncate text-muted" title=""></small>
                        <button type="button" class="btn btn-sm btn-outline-danger mt-2">Delete</button>
                    </div>
                `;
                const img = card.querySelector('img');
                img.src = imgSrc;
                img.addEventListener('click', () => openLightbox(imgSrc));
                const label = card.querySelector('small');
                label.textContent = filename;
                label.title = filename;
                card.querySelector('button').addEventListener('click', () => deleteSnapshot(filename, card));
                document.getElementById('gallery').appendChild(card);
            }

            function openLightbox(src) {
                const box = document.getElementById('lightbox');
                document.getElementById('lightbox-img').src = src;
                box.classList.remove('d-none');
            }

            function closeLightbox() {
                const box = document.getElementById('lightbox');
                box.classList.add('d-none');
                document.getElementById('lightbox-img').src = '';
            }

            document.getElementById('lightbox').addEventListener('click', (e) => {
                if (e.target.id !== 'lightbox-img') closeLightbox();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeLightbox();
            });

            function deleteSnapshot(filename, card) {
                fetch('/admin/snapshot/' + encodeURIComponent(filename), { method: 'DELETE' })
                    .then(r => r.json())
                    .then(data => {
                        if (data.ok) {
                            card.remove();
                            removeFromSession(filename);
                            flasher.success(data.message);
                        } else {
                            alert('Delete failed: ' + (data.error || 'unknown'));
                        }
                    })
                    .catch(err => alert('Delete error: ' + err.message));
            }

            function clearSession() {
                if (!confirm('Clear current session? Captured files will remain on disk.')) return;
                localStorage.removeItem(SESSION_KEY);
                document.getElementById('gallery').innerHTML = '';
            }

            function restoreSession() {
                const gallery = document.getElementById('gallery');
                gallery.innerHTML = '';
                loadSession().forEach(filename => appendToGallery(filename));
            }

            function updateOverlay() {
                const value = document.getElementById('magnification').value;
                const overlay = document.getElementById('overlay');
                overlay.src = `/images/overlays/x${value}.png`;
                overlay.style.display = 'block';
            }

            document.getElementById('magnification').addEventListener('change', updateOverlay);
            updateOverlay();
            restoreSession();
        </script>
    {% endblock %}
{% endblock %}
